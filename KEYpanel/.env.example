# OneCore MyThos KEYpanel production template
# Copy this file to .env on hosting. NEVER commit the real .env.

APP_ENV=production
APP_URL=https://panel.example.com
APP_BASE_PATH=
APP_TIMEZONE=UTC
PANEL_NAME=OneCore MyThos
SESSION_NAME=onecore_mythos_panel
SETUP_TOKEN=CHANGE_TO_A_RANDOM_64_HEX_VALUE

# Leave empty on normal shared hosting. Add only reverse-proxy IPs you control.
TRUSTED_PROXY_IPS=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Optional Telegram owner/admin control bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=CHANGE_TO_RANDOM_LETTERS_NUMBERS_UNDERSCORES_HYPHENS
TELEGRAM_ALLOWED_USER_IDS=

# Generated automatically during first /setup.
# Private key stays only on hosting. Public key is copied to GitHub Actions Variables.
API_PRIVATE_KEY_PATH=runtime/api-private.pem
API_PUBLIC_KEY_PATH=runtime/api-public.b64

# OneCore MyThos Android production identity.
EXPECTED_ANDROID_PACKAGE=OneCore.Vip
EXPECTED_ANDROID_CERT_SHA256=B343111BBFA30ED565F9B61A52CF5B34CB2EAF0485EB8B396AB373B2ECCA53D4
MIN_ANDROID_VERSION_CODE=1
