<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#05090F"
                android:centerColor="#0B121E"
                android:endColor="#111A28"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Subtle Tech Pattern Overlay (Simulated with Gradient because we lack a pattern image) -->
    <!-- We can use a radial gradient to simulate a glow or spotlight effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:gradientRadius="800dp"
                android:centerX="0.5"
                android:centerY="0.2"
                android:startColor="#1A2D45"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
