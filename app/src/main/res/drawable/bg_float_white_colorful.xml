<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main White Glass Background -->
    <item>
        <shape>
            <solid android:color="#F7FFFFFF" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>

    <!-- Bubbles -->
    <item android:width="120dp" android:height="120dp" android:top="-30dp" android:left="-30dp">
        <shape android:shape="oval">
            <gradient android:startColor="#20A855F7" android:endColor="#00A855F7" android:gradientRadius="60dp" android:type="radial" />
        </shape>
    </item>
    <item android:width="140dp" android:height="140dp" android:bottom="-40dp" android:right="-40dp">
        <shape android:shape="oval">
            <gradient android:startColor="#20EC4899" android:endColor="#00EC4899" android:gradientRadius="70dp" android:type="radial" />
        </shape>
    </item>

    <!-- Top Border -->
    <item android:height="4dp" android:gravity="top">
        <shape>
            <gradient android:startColor="#EC4899" android:centerColor="#A855F7" android:endColor="#3B82F6" android:angle="0" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
