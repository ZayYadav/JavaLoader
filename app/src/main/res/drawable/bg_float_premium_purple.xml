<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Glassmorphism Background (Deep Purple/Blue) -->
    <item>
        <shape>
            <gradient
                android:startColor="#F21A0B2E"
                android:centerColor="#F20D0D2B"
                android:endColor="#F21A0B2E"
                android:angle="45" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Top Glow (Pink/Purple) -->
    <item android:height="4dp" android:gravity="top" android:top="0dp">
        <shape>
            <gradient
                android:startColor="#EC4899"
                android:centerColor="#A855F7"
                android:endColor="#3B82F6"
                android:angle="0" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
