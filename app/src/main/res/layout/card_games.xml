<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginVertical="8dp"
     android:background="@drawable/bg_card_glass"
     android:layout_marginHorizontal="16dp"
     android:padding="16dp">

    <ImageView
         android:layout_height="80dp"
         android:layout_width="80dp"
         android:scaleType="centerCrop"
         android:src="@drawable/pubg_global"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         android:clipToOutline="true"
         android:id="@+id/gameIcon" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="0dp"
         app:layout_constraintTop_toTopOf="@id/gameIcon"
         android:orientation="vertical"
         app:layout_constraintStart_toEndOf="@id/gameIcon"
         app:layout_constraintEnd_toEndOf="parent"
         android:layout_marginStart="16dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:orientation="horizontal">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="18sp"
                 android:fontFamily="sans-serif-medium"
                 android:textColor="#FFFFFF"
                 android:layout_weight="1"
                 android:id="@+id/gameTitle"
                 android:text="PUBG Mobile" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="@drawable/bg_badge_region"
                 android:paddingVertical="3dp"
                 android:textSize="10sp"
                 android:textColor="#FFFFFF"
                 android:layout_marginStart="8dp"
                 android:paddingHorizontal="8dp"
                 android:id="@+id/gameRegion"
                 android:text="GLOBAL"
                 android:textStyle="bold" />

        </LinearLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="#B0B0B0"
             android:layout_marginTop="2dp"
             android:id="@+id/gameGenre"
             android:text="Action" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:orientation="vertical"
             android:layout_marginTop="6dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <ImageView
                     android:layout_height="12dp"
                     android:layout_width="12dp"
                     android:src="@drawable/ic_check_circle_green_24dp"
                     app:tint="#6CFF00" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:textColor="#6CFF00"
                     android:layout_marginStart="4dp"
                     android:id="@+id/gameStatus"
                     android:text="DOWNLOADED"
                     android:textStyle="bold" />

            </LinearLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="#B0B0B0"
                 android:layout_marginTop="2dp"
                 android:id="@+id/gameVersion"
                 android:text="Version: 4.2.0" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="#B0B0B0"
                 android:layout_marginTop="2dp"
                 android:id="@+id/gameSize"
                 android:text="Calculating..." />

        </LinearLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:visibility="gone"
             android:id="@+id/gamePackage" />

    </LinearLayout>

    <TextView
         android:layout_height="35dp"
         android:layout_width="0dp"
         android:layout_marginEnd="12dp"
         android:textSize="14sp"
         android:textColor="#FFFFFF"
         app:layout_constraintEnd_toStartOf="@id/noBtn"
         android:layout_marginTop="16dp"
         app:layout_constraintTop_toBottomOf="@id/gameIcon"
         android:gravity="center"
         android:background="@drawable/btn_install_glow"
         app:layout_constraintStart_toStartOf="parent"
         android:id="@+id/okBtn"
         android:text="DOWNLOAD"
         android:textStyle="bold" />

    <TextView
         android:layout_height="35dp"
         android:layout_width="35dp"
         android:gravity="center"
         android:background="@drawable/bg_btn_trash"
         app:layout_constraintTop_toTopOf="@id/okBtn"
         android:textSize="18sp"
         android:textColor="#B0B0B0"
         app:layout_constraintEnd_toEndOf="parent"
         android:id="@+id/noBtn"
         android:text="🗑" />

</androidx.constraintlayout.widget.ConstraintLayout>