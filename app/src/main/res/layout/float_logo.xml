<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/logo_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginStart="2.5dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.BlackBox.Circle"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            android:padding="2dp"
            android:background="@drawable/bg_glass_card_white"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/menu_view"
        android:background="@drawable/bg_float_white_colorful"
        android:visibility="visible"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="45dp"
        android:paddingBottom="10dp"
        android:elevation="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZORO LOADER"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/arrow_drop_down"
                app:tint="#1A1A1A"/>
        </LinearLayout>
        <View
            android:background="#1A000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"/>
        <ScrollView
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:fadeScrollbars="false">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="60dp">

                <TextView
                    android:textStyle="bold"
                    android:textColor="#A855F7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESP SETTINGS"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/esp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable ESP"
                    android:textColor="#333333"
                    android:buttonTint="#A855F7"/>
                <CheckBox
                    android:id="@+id/box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Box"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Line"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skeleton"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/health"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Health Bar"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Head Circle"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/alert360"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="360 Alert"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/grenade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grenade Warning"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/weapon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enemy Weapon"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/vehicles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vehicles ESP"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>
                <CheckBox
                    android:id="@+id/loot_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loot Box Items"
                    android:textColor="#333333"
                    android:buttonTint="#EC4899"/>

                <View
                    android:background="#1A000000"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="15dp"/>

                <TextView
                    android:textStyle="bold"
                    android:textColor="#3B82F6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AIMBOT SETTINGS"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/aimbot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aimbot"
                    android:textColor="#333333"
                    android:buttonTint="#3B82F6"/>

                <TextView
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target"
                    android:textSize="11sp"
                    android:layout_marginStart="5dp"/>
                <RadioGroup
                    android:id="@+id/aimbotMode"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <RadioButton
                        android:id="@+id/aim_head"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Head"
                        android:textSize="10sp"
                        android:textColor="#333333"
                        android:buttonTint="#3B82F6"/>
                    <RadioButton
                        android:id="@+id/aim_chest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chest"
                        android:textSize="10sp"
                        android:textColor="#333333"
                        android:buttonTint="#3B82F6"/>
                    <RadioButton
                        android:id="@+id/aim_body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Body"
                        android:textSize="10sp"
                        android:textColor="#333333"
                        android:buttonTint="#3B82F6"/>
                </RadioGroup>

                <TextView
                    android:id="@+id/txt_fov"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOV Size: 0"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"/>
                <SeekBar
                    android:id="@+id/sk_fov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="500"
                    android:progress="0"
                    android:progressTint="#3B82F6"
                    android:thumbTint="#3B82F6"/>

                <TextView
                    android:id="@+id/txt_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aimbot Range: 1"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"/>
                <SeekBar
                    android:id="@+id/sk_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="150"
                    android:progress="1"
                    android:progressTint="#3B82F6"
                    android:thumbTint="#3B82F6"/>

                <View
                    android:background="#1A000000"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="15dp"/>

                <TextView
                    android:textStyle="bold"
                    android:textColor="#EC4899"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OTHER SETTINGS"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txt_recoil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recoil: 0%"
                    android:textColor="#333333"
                    android:textSize="12sp"/>
                <SeekBar
                    android:id="@+id/sk_recoil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#EC4899"
                    android:thumbTint="#EC4899"/>

                <TextView
                    android:id="@+id/txt_ipad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iPad View: 1x"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"/>
                <SeekBar
                    android:id="@+id/sk_ipad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="8"
                    android:progress="1"
                    android:progressTint="#EC4899"
                    android:thumbTint="#EC4899"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
